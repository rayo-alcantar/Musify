<Window x:Class="Intento4.RegistrarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Usuario" Height="450" Width="800"
        Background="#121212">
    <Grid>
        <!-- Contenedor principal -->
        <Border Background="#1E1E1E" CornerRadius="10" Width="320" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <StackPanel>
                <!-- Título -->
                <TextBlock Text="Registro de Usuario" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Nombre -->
                <StackPanel Margin="0,10">
                    <Label x:Name="lblNombre" Content="Nombre completo" Target="{Binding ElementName=txtNombre}" Foreground="#B3B3B3" FontSize="12" Margin="5,0,0,2"/>
                    <TextBox x:Name="txtNombre" Width="250" Height="40" 
                             Background="#2A2A2A" Foreground="White" BorderBrush="#1DB954" BorderThickness="1"
                             FontSize="14" AutomationProperties.LabeledBy="{Binding ElementName=lblNombre}"/>
                </StackPanel>

                <!-- Correo -->
                <StackPanel Margin="0,10">
                    <Label x:Name="lblCorreo" Content="Correo electrónico" Target="{Binding ElementName=txtCorreo}" Foreground="#B3B3B3" FontSize="12" Margin="5,0,0,2"/>
                    <TextBox x:Name="txtCorreo" Width="250" Height="40" 
                             Background="#2A2A2A" Foreground="White" BorderBrush="#1DB954" BorderThickness="1"
                             FontSize="14" AutomationProperties.LabeledBy="{Binding ElementName=lblCorreo}"/>
                </StackPanel>

                <!-- Contraseña -->
                <StackPanel Margin="0,10">
                    <Label x:Name="lblContraseña" Content="Contraseña" Target="{Binding ElementName=txtContraseña}" Foreground="#B3B3B3" FontSize="12" Margin="5,0,0,2"/>
                    <PasswordBox x:Name="txtContraseña" Width="250" Height="40" 
                                 Background="#2A2A2A" Foreground="White" BorderBrush="#1DB954" BorderThickness="1"
                                 FontSize="14" AutomationProperties.LabeledBy="{Binding ElementName=lblContraseña}"/>
                </StackPanel>

                <!-- Fecha de nacimiento -->
                <StackPanel Margin="0,10">
                    <Label x:Name="lblFecha" Content="Fecha de nacimiento" Target="{Binding ElementName=dpFecha}" Foreground="#B3B3B3" FontSize="12" Margin="5,0,0,2"/>
                    <DatePicker x:Name="dpFecha" Width="250" Height="40" 
                                Background="#2A2A2A" Foreground="White" BorderBrush="#1DB954" BorderThickness="1"
                                FontSize="14" AutomationProperties.LabeledBy="{Binding ElementName=lblFecha}"/>
                </StackPanel>

                <Button x:Name="btnRegistrar" Content="Registrar" Width="250" Height="40"
                        Background="#1DB954" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="BtnRegistrar_Click" />

                <!-- Botón Registrar -->
            </StackPanel>
        </Border>
    </Grid>
</Window>


