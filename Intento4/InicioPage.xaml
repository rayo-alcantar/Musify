<Page x:Class="Intento4.InicioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="InicioPage"
      d:DesignHeight="800" d:DesignWidth="1720">

    <DockPanel LastChildFill="True">
        <!-- CONTENIDO PRINCIPAL -->
        <Grid Background="#121212" Margin="10">

            <!-- Títulos -->
            <TextBlock Text="Bienvenido a Musify"
                       Foreground="White" FontSize="30" FontWeight="Bold"
                       Margin="200,14,0,0" VerticalAlignment="Top"/>
            <TextBlock Text="Música recomendada para ti"
                       Foreground="Gray" FontSize="14"
                       Margin="200,58,0,0"  VerticalAlignment="Top"/>

            <!-- ***** BOTONES DE ÁLBUMES ***** -->
            <Button Margin="223,100,1087,479"
                    Width="180" Height="180"
                    Click="SabrinaButton_Click"
                    AutomationProperties.Name="Álbum Sabrina">
                <Button.Background>
                    <ImageBrush ImageSource="Images/Sabrina.jpg"/>
                </Button.Background>
            </Button>

            <Button Margin="477,100,833,479"
                    Width="180" Height="180"
                    Click="RauwButton_Click"
                    AutomationProperties.Name="Álbum Rauw">
                <Button.Background>
                    <ImageBrush ImageSource="Images/Rauw.jpg"/>
                </Button.Background>
            </Button>

            <Button Margin="730,100,580,479"
                    Width="180" Height="180"
                    Click="JadenButton_Click"
                    AutomationProperties.Name="Álbum Jaden">
                <Button.Background>
                    <ImageBrush ImageSource="Images/Jaden.jpg"/>
                </Button.Background>
            </Button>

            <Button Margin="206,435,1087,155"
                    Width="180" Height="180"
                    Click="UVSTButton_Click"
                    AutomationProperties.Name="Álbum Un Verano Sin Ti">
                <Button.Background>
                    <ImageBrush ImageSource="Images/Un Verano Sin Ti.jpg"/>
                </Button.Background>
            </Button>

            <Button Margin="443,435,875,155"
                    Width="180" Height="180"
                    Click="_1989Button_Click"
                    AutomationProperties.Name="Álbum 1989">
                <Button.Background>
                    <ImageBrush ImageSource="Images/1989.jpg"/>
                </Button.Background>
            </Button>

            <Button Margin="684,435,634,155"
                    Width="180" Height="180"
                    Click="JusticeButton_Click"
                    AutomationProperties.Name="Álbum Justice">
                <Button.Background>
                    <ImageBrush ImageSource="Images/Justice.jpg"/>
                </Button.Background>
            </Button>

        </Grid>
    </DockPanel>
</Page>
