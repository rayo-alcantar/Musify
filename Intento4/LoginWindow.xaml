<Window x:Class="Intento4.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión" Height="300" Width="400"
        Background="#121212" MinWidth="1300" MinHeight="750">

    <Grid>
        <!-- Fondo de la imagen -->
        <Grid.Background>
            <ImageBrush ImageSource="\Images\fondo.png"/>
        </Grid.Background>

        <!-- Botón "Admin" en la esquina superior derecha -->
        <Button Content="Administrador" Width="100" Height="30" Background="#AA000000" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Click="LoginAdminButton_Click" />

        <!-- Título -->
        <TextBlock Text="Iniciar Sesión en Musify" Foreground="White" FontSize="35" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="457,261,0,0" RenderTransformOrigin="0.062,1.073" />

        <!-- Usuario -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="554,364,0,0">
            <!-- Label accesible para el campo de usuario -->
            <Label x:Name="lblUsuario" Content="Correo electrónico" Visibility="Collapsed"/>
            <!-- Campo de texto para usuario -->
            <TextBox Name="usernameTextBox" Width="200" Height="30" 
                     Foreground="White" Background="#2A2A2A" 
                     BorderBrush="#1DB954" BorderThickness="1" 
                     FontSize="14" FontWeight="Bold" 
                     GotFocus="UsernameTextBox_GotFocus" LostFocus="UsernameTextBox_LostFocus"
                     AutomationProperties.LabeledBy="{Binding ElementName=lblUsuario}" />

            <!-- Placeholder (TextBlock) para el campo de usuario -->
            <TextBlock x:Name="UsernamePlaceholder" Text="Correo" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" FontSize="14" FontWeight="Bold" IsHitTestVisible="False" />
        </Grid>

        <!-- Contraseña -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="554,414,0,0">
            <PasswordBox Name="passwordBox" Width="200" Height="30" 
                         Foreground="White" Background="#2A2A2A" 
                         BorderBrush="#1DB954" BorderThickness="1" 
                         FontSize="14" FontWeight="Bold" 
                         GotFocus="PasswordBox_GotFocus" LostFocus="PasswordBox_LostFocus" />

            <!-- Placeholder (TextBlock) para el campo de contraseña -->
            <TextBlock x:Name="PasswordPlaceholder" Text="Contraseña" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" FontSize="14" FontWeight="Bold" IsHitTestVisible="False" />
        </Grid>

        <!-- Botón de iniciar sesión -->
        <Button Content="Ingresar" Width="200" Background="#1DB954" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="552,509,0,0" Click="LoginButton_Click"/>

        <!-- Botón de Registrarse -->
        <Button Content="Registrarse" Width="116" Background="#1DB954" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="594,540,0,0" Click="BtnRegistrar_Click"/>

    </Grid>
</Window>
