<Page x:Class="Intento4.BibliotecaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Intento4"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1720">

    <Grid Background="#121212">

        <!-- Título de la biblioteca -->
        <StackPanel VerticalAlignment="Top" Margin="273,126,515,0">
            <TextBlock Text="Biblioteca de Canciones" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Left"/>
            <TextBlock Text="Selecciona para reproducir" Foreground="Gray" FontSize="18" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Cuadro de búsqueda -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,142,410,0">
            <!-- Contenedor con TextBox y Watermark -->
            <Grid>
                <!-- TextBox -->
                <TextBox Name="SearchBox" Width="300" Height="30" FontSize="14" TextChanged="SearchBox_TextChanged"/>

                <!-- Watermark con TextBlock que se oculta al escribir -->
            </Grid>

            <Button Content="Buscar" Width="80" Height="30" Margin="10,0,0,0" Click="SearchButton_Click"/>
        </StackPanel>

        <!-- Sección de Playlists -->
        <TextBlock Text="Mis Playlists" Foreground="White" FontSize="20" FontWeight="SemiBold"
                   HorizontalAlignment="Left" Margin="361,200,0,0" VerticalAlignment="Top"/>
        <ListBox x:Name="PlaylistsListBox" Height="100" Margin="361,230,0,0" HorizontalAlignment="Left"
                 Width="300" VerticalAlignment="Top" Background="#1A1A1A" BorderBrush="Gray" Foreground="White"
                 SelectionChanged="PlaylistsListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding nombre}" FontSize="14" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Botón para crear nueva playlist -->
        <Button x:Name="CrearPlaylistButton" Content="Crear Nueva Playlist" Click="CrearPlaylistButton_Click"
                Margin="361,340,0,0" HorizontalAlignment="Left" Width="200" Height="30" VerticalAlignment="Top"
                Background="#FF4CAF50" Foreground="White" BorderBrush="{x:Null}"/>

        <!-- Listado de canciones -->
        <ListBox Name="ListaCanciones" Margin="361,380,369,95" Background="#1A1A1A" BorderBrush="Transparent" Foreground="White"
                 SelectionChanged="ListaCanciones_SelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="SongContextMenu" Opening="SongContextMenu_Opening">
                    <MenuItem Header="Añadir a Playlist Seleccionada" Click="AddSongToPlaylist_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Existing DataTemplate for song display -->
                    <StackPanel Orientation="Vertical" Margin="5">
                        <TextBlock Text="{Binding titulo}" Foreground="White" FontSize="16" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="{Binding artista}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Page>
