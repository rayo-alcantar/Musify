<Page x:Class="Intento4.BibliotecaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1720">

    <Grid Background="#121212">

        <!-- =====  PANEL PLAYLISTS PRIVADAS  ===== -->
        <Border Background="#1A1A1A" Width="250" HorizontalAlignment="Left" Margin="30,120,0,95"
                CornerRadius="6">
            <StackPanel Margin="10">
                <TextBlock Text="Tus playlists" Foreground="White" FontSize="18"
                           FontWeight="Bold" Margin="0,0,0,10"/>
                <ListView Name="PlaylistsListView" Background="Transparent" BorderBrush="Transparent"
                          Foreground="White"
                          SelectionChanged="PlaylistsListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding nombre}" FontSize="14"
                                       AutomationProperties.Name="{Binding nombre}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- =====  TÍTULO  ===== -->
        <StackPanel VerticalAlignment="Top" Margin="300,126,515,0">
            <TextBlock Text="Biblioteca de Canciones" Foreground="White"
                       FontSize="36" FontWeight="Bold"/>
            <TextBlock Text="Selecciona para reproducir"
                       Foreground="Gray" FontSize="18"/>
        </StackPanel>

        <!-- =====  CUADRO DE BÚSQUEDA  ===== -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                    HorizontalAlignment="Right" Margin="0,142,410,0">
            <TextBox Name="SearchBox" Width="300" Height="30"
                     FontSize="14" TextChanged="SearchBox_TextChanged"/>
            <Button Content="Buscar" Width="80" Height="30" Margin="10,0,0,0"
                    Click="SearchButton_Click"/>
        </StackPanel>

        <!-- =====  LISTADO DE CANCIONES  ===== -->
        <ListBox Name="ListaCanciones" Margin="300,302,30,95"
                 Background="#1A1A1A" BorderBrush="Transparent" Foreground="White"
                 SelectionChanged="ListaCanciones_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding titulo}" FontSize="16"/>
                        <TextBlock Text="{Binding artista}" Foreground="Gray" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Page>
