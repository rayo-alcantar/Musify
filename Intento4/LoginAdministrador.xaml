<Window x:Class="Intento4.LoginAdministrador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Usuario" Height="450" Width="800"
		WindowState="Maximized"
        Background="#121212">
    <Grid>
        <!-- Contenedor principal -->
        <Border Background="#1E1E1E" CornerRadius="10" Width="320" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <StackPanel>
                <!-- Título -->
                <TextBlock Text="Administrador" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Nombre -->
                <StackPanel Margin="0,10">
                    <TextBlock Text="Usuario " Foreground="#B3B3B3" FontSize="12" Margin="5,0,0,2"/>
                    <TextBox Name="txtNombre" Width="250" Height="40" 
                             Background="#2A2A2A" Foreground="White" BorderBrush="#1DB954" BorderThickness="1"
                             FontSize="14" />
                </StackPanel>

                <!-- Contraseña -->
                <StackPanel Margin="0,10">
                    <TextBlock Text="Contraseña" Foreground="#B3B3B3" FontSize="12" Margin="5,0,0,2"/>
                    <PasswordBox Name="txtContraseña" Width="250" Height="40" 
                                 Background="#2A2A2A" Foreground="White" BorderBrush="#1DB954" BorderThickness="1"
                                 FontSize="14" />
                </StackPanel>

                <!-- Botón "Ingresar" -->
                <Button x:Name="btnRegistrar" Content="Ingresar" Width="250" Height="40"
                        Background="#1DB954" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="BtnRegistrar_Click" />

            </StackPanel>
        </Border>
    </Grid>
</Window>
