<Page x:Class="Intento4.RyB"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Intento4"
      mc:Ignorable="d" 
        d:DesignHeight="800" d:DesignWidth="1720">

    <Grid Background="#121212">

        <!-- Imagen del álbum -->
        <Image Source=".\Images\RyB.jpg"
       Width="250" Height="250" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="399,10,0,0"/>

        <!-- Título del álbum y autor -->
        <StackPanel VerticalAlignment="Top" Margin="399,111,389,0">
            <TextBlock Text="RyB" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Listado de canciones -->
        <ListBox Name="ListaCanciones" Margin="365,289,365,148" Background="#1A1A1A" BorderBrush="Transparent" Foreground="White"
         SelectionChanged="ListaCanciones_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="5">
                        <!-- Título de la canción -->
                        <TextBlock Text="{Binding titulo}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>

                        <!-- Artista de la canción -->
                        <TextBlock Text="{Binding artista}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
