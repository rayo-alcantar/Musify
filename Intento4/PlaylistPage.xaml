<Page x:Class="Intento4.PlaylistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Intento4"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Crear Playlist">

    <Grid Background="#121212">
        <!-- Título de la página -->
        <StackPanel VerticalAlignment="Top" Margin="20">
            <TextBlock Text="Crea Tu Playlist Automática" Foreground="White" FontSize="24" FontWeight="Bold" Margin="10" Width="662"/>
            <TextBlock Text="Selecciona un estado de ánimo, actividad o momento del día para generar tu playlist." Foreground="Gray" FontSize="14" Height="20" Width="651"/>
            <!-- Nuevo elemento para mostrar el título de la playlist -->
            <TextBlock x:Name="PlaylistTitle" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Contenedor para el primer ComboBox y el botón -->
        <StackPanel VerticalAlignment="Top" Margin="77,100,20,0">
            <ComboBox x:Name="categoryComboBox" Background="#333333" Foreground="#191919" FontSize="16" Margin="0,0,0,20" Width="699" SelectionChanged="CategoryComboBox_SelectionChanged">
                <ComboBoxItem Content="estado_animo" />
                <ComboBoxItem Content="actividad" />
                <ComboBoxItem Content="momento_dia" />
            </ComboBox>

            <!-- Segundo ComboBox que cambia dependiendo de la selección -->
            <ComboBox x:Name="optionsComboBox" Background="#333333" Foreground="#191919" FontSize="16" Margin="0,0,0,20" Width="699" IsEnabled="False">
                <!-- Las opciones se llenarán dinámicamente -->
            </ComboBox>

            <!-- Botón para generar playlist -->
            <Button Content="Generar Playlist" Background="#1DB954" Foreground="#191919" FontSize="16" Width="200" Height="40" Margin="0,10,0,0" Click="GenerarPlaylist_Click" />
        </StackPanel>

        <!-- Título del álbum y autor -->
        <StackPanel VerticalAlignment="Top" Margin="585,135,203,0">
            <TextBlock Text="Mix" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ListBox para las canciones -->
        <ListBox Name="ListaCanciones" Margin="361,302,369,95" Background="#1A1A1A" BorderBrush="Transparent" Foreground="White"
         SelectionChanged="ListaCanciones_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="5">
                        <!-- Título de la canción -->
                        <TextBlock Text="{Binding titulo}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>

                        <!-- Artista de la canción -->
                        <TextBlock Text="{Binding artista}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Page>
