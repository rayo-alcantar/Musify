<Page x:Class="Intento4.PlaylistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Intento4"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Crear Playlist">

	<Grid Background="#121212">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Row="0" Margin="20,20,20,10" HorizontalAlignment="Center">
			<TextBlock Text="Crea Tu Playlist Automática" Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
			<TextBlock Text="Selecciona un estado de ánimo, actividad o momento del día para generar tu playlist." Foreground="Gray" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
			<TextBlock x:Name="PlaylistTitle" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
		</StackPanel>

		<StackPanel Grid.Row="1" Margin="20,0,20,20" HorizontalAlignment="Center">
			<ComboBox x:Name="categoryComboBox" Background="#333333" Foreground="#191919" FontSize="16" Margin="0,0,0,20" Width="400" SelectionChanged="CategoryComboBox_SelectionChanged">
				<ComboBoxItem Content="estado_animo" />
				<ComboBoxItem Content="actividad" />
				<ComboBoxItem Content="momento_dia" />
			</ComboBox>

			<ComboBox x:Name="optionsComboBox" Background="#333333" Foreground="#191919" FontSize="16" Margin="0,0,0,20" Width="400" IsEnabled="False">
			</ComboBox>

			<Button Content="Generar Playlist" Background="#1DB954" Foreground="#191919" FontSize="16" Width="200" Height="40" Margin="0,10,0,0" Click="GenerarPlaylist_Click" />
		</StackPanel>

		<ListBox Name="ListaCanciones" Grid.Row="2" Margin="20,0,20,20" Background="#1A1A1A" BorderBrush="Transparent" Foreground="White"
                 SelectionChanged="ListaCanciones_SelectionChanged">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Vertical" Margin="5">
						<TextBlock Text="{Binding titulo}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding artista}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

	</Grid>
</Page>