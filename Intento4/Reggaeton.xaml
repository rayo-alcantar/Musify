<Page x:Class="Intento4.Reggaeton"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Intento4"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1720">

	<Grid Background="#121212">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="20,20,0,20">
			<Image Source=".\Images\Reggaton.jpg"
                   Width="250" Height="250"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>

			<StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
				<TextBlock Text="Reggaeton" Foreground="White" FontSize="36" FontWeight="Bold" />
			</StackPanel>
		</StackPanel>

		<ListBox Name="ListaCanciones" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 Margin="20,0,20,20" Background="#1A1A1A" BorderBrush="Transparent" Foreground="White"
                 SelectionChanged="ListaCanciones_SelectionChanged">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Vertical" Margin="5">
						<TextBlock Text="{Binding titulo}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
						<TextBlock Text="{Binding artista}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Grid>
</Page>