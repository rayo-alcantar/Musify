<Window x:Class="Intento4.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowState="Maximized"
        Title="Panel de Administración"
        Background="#121212"
        MinHeight="750" MinWidth="1300">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="\Images\fondo.png" />
        </Grid.Background>

        <TextBlock Text="Panel de Administración" Foreground="White" FontSize="35" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />

        <Grid Margin="30,100,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="10" Margin="0,0,10,0">
                <TextBlock Text="Listado de Canciones"
                           Foreground="#B3B3B3" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#1DB954" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="Gestión de Canciones" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Título" Foreground="#B3B3B3" FontSize="12"/>
                        <TextBox x:Name="txtTitulo" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Artista" Foreground="#B3B3B3" FontSize="12"/>
                        <TextBox x:Name="txtArtista" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Álbum" Foreground="#B3B3B3" FontSize="12"/>
                        <TextBox x:Name="txtAlbum" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Género" Foreground="#B3B3B3" FontSize="12"/>
                        <ComboBox x:Name="cmbGenero" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14">
                            <ComboBoxItem Content="Pop"/>
                            <ComboBoxItem Content="Rock"/>
                            <ComboBoxItem Content="Reggaeton"/>
                            <ComboBoxItem Content="RyB"/>
                            <ComboBoxItem Content="Rap"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Momento del Día" Foreground="#B3B3B3" FontSize="12"/>
                        <ComboBox x:Name="cmbMomentoDia" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14">
                            <ComboBoxItem Content="Mañana"/>
                            <ComboBoxItem Content="Tarde"/>
                            <ComboBoxItem Content="Noche"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Estado de Ánimo" Foreground="#B3B3B3" FontSize="12"/>
                        <ComboBox x:Name="cmbEstadoAnimo" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14">
                            <ComboBoxItem Content="Alegre"/>
                            <ComboBoxItem Content="Triste"/>
                            <ComboBoxItem Content="Relajado"/>
                            <ComboBoxItem Content="Motivado"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,5">
                        <TextBlock Text="Actividad" Foreground="#B3B3B3" FontSize="12"/>
                        <ComboBox x:Name="cmbActividad" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14">
                            <ComboBoxItem Content="Estudiar"/>
                            <ComboBoxItem Content="Hacer Ejercicio"/>
                            <ComboBoxItem Content="Relajarse"/>
                            <ComboBoxItem Content="Fiesta"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Ruta del Archivo" Foreground="#B3B3B3" FontSize="12"/>
                        <TextBox x:Name="txtRutaArchivo" Background="#1E1E1E" Foreground="White" BorderBrush="#1DB954" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="Agregar" Width="100" Background="#1DB954" Foreground="White" Margin="5" Click="AgregarCancion_Click"/>
                        <Button Content="Actualizar" Width="100" Background="#FFA500" Foreground="White" Margin="5" Click="ActualizarCancion_Click"/>
                        <Button Content="Eliminar" Width="100" Background="#FF0000" Foreground="White" Margin="5" Click="EliminarCancion_Click"/>
                        <Button Content="Buscar" Width="100" Background="#1DB954" Foreground="White" Margin="5" Click="BuscarCancion_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>