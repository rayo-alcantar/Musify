<Window x:Class="Intento4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Musify" Height="800" Width="1920" Background="#121212"
        MinWidth="800" MinHeight="450">

    <Grid>
        <!-- Frame principal para navegación -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" 
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Barra lateral -->
        <StackPanel HorizontalAlignment="Left" Background="#1DB954" Width="200">
            <TextBlock Text="Musify" Foreground="White" FontSize="16" Margin="10" FontWeight="Bold" />
            <Button Content="Inicio" Margin="10" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="ShowInicio2_Click" />
            <Button Content="Explorar" Margin="10" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="ShowExplorar_Click" />
            <Button Content="Tu Biblioteca" Margin="10" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="ShowTuBiblioteca_Click" />
            <Button Content="Crear Playlist" Margin="10" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="ShowPlaylist_Click" />
        </StackPanel>

        <!-- Panel de lo que escuchan los amigos -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#333333" Width="300">
            <TextBlock Text="Actividad de Amigos" Foreground="White" FontSize="16" Margin="10" FontWeight="Bold" />
            <ListBox Foreground="White" Background="#121212" BorderBrush="Transparent" Margin="10">
                <!-- Ejemplo de amigo 1 -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source=".\Images\Itzel.jpg" Width="40" Height="40" Margin="10" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Itzel Durán" Foreground="White" FontSize="14" />
                            <TextBlock Text="Anyone - Justin Bieber" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source=".\Images\Diego.jpg" Width="40" Height="40" Margin="10" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Diego Duron" Foreground="White" FontSize="14" />
                            <TextBlock Text="Not Like Us - Kendrick Lamar" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>

                <!-- Ejemplo de amigo 3 -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source=".\Images\Aldo.jpg" Width="40" Height="40" Margin="10" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Aldo Durán" Foreground="White" FontSize="14" />
                            <TextBlock Text="Vista al Mar - Quevedo" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source=".\Images\Fernanda.jpg" Width="40" Height="40" Margin="10" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Fernanda Ávila" Foreground="White" FontSize="14" />
                            <TextBlock Text="The Archer - Taylor Swift" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </StackPanel>

        <!-- Barra de reproducción -->
        <DockPanel VerticalAlignment="Bottom" Background="#1A1A1A" Height="136">
            <Image Source="Images\spotify-icon-spotify-logo-spotify-symbol-logo-set-free-vector.jpg"
                   Width="60" Height="60" Margin="10" VerticalAlignment="Center"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10">
                <TextBlock Name="SongTitle" Text="Título de la canción" Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Name="SongArtist" Text="Artista de la canción" Foreground="Gray" FontSize="12"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                <Button Content="⏮" Width="40" Height="40" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="PreviousSong_Click"/>
                <Button Content="⏸" Width="40" Height="40" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="PauseSong_Click"/>
                <Button Content="⏭" Width="40" Height="40" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="NextSong_Click"/>
            </StackPanel>
            <Slider Width="200" VerticalAlignment="Center" Maximum="100" Value="30"
                    Background="#333333" Foreground="#1DB954" BorderBrush="#1DB954"/>
            <TextBlock Name="PlayerStatus" Text="Estado del reproductor" Foreground="Gray" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"/>
        </DockPanel>
    </Grid>
</Window>


