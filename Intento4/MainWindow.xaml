<!-- File: MainWindow.xaml -->
<Window x:Class="Intento4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Musify" Height="800" Width="1920" Background="#121212"
        MinWidth="800" MinHeight="450">

    <Grid>
        <!-- Frame principal para navegación -->
        <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Barra lateral de navegación -->
        <StackPanel x:Name="Sidebar"
                    HorizontalAlignment="Left"
                    Background="#1DB954"
                    Width="200">
            <TextBlock Text="Musify"
                       Foreground="White"
                       FontSize="16"
                       Margin="10"
                       FontWeight="Bold"/>

            <!-- Botones de navegación -->
            <Button x:Name="InicioButton"
                    Content="Inicio"
                    ToolTip="Ir a Inicio"
                    AutomationProperties.Name="Botón Inicio"
                    Margin="10"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="ShowInicio2_Click"/>

            <Button x:Name="ExplorarButton"
                    Content="Explorar"
                    ToolTip="Ir a Explorar"
                    AutomationProperties.Name="Botón Explorar"
                    Margin="10"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="ShowExplorar_Click"/>

            <Button x:Name="BibliotecaButton"
                    Content="Tu Biblioteca"
                    ToolTip="Ir a Tu Biblioteca"
                    AutomationProperties.Name="Botón Tu Biblioteca"
                    Margin="10"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="ShowTuBiblioteca_Click"/>

            <Button x:Name="PlaylistButton"
                    Content="Crear Playlist"
                    ToolTip="Ir a Crear Playlist"
                    AutomationProperties.Name="Botón Crear Playlist"
                    Margin="10"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Click="ShowPlaylist_Click"/>
        </StackPanel>

        <!-- Panel de actividad de amigos -->
        <StackPanel x:Name="FriendsPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="#333333"
                    Width="300">
            <TextBlock Text="Actividad de Amigos"
                       Foreground="White"
                       FontSize="16"
                       Margin="10"
                       FontWeight="Bold"/>

            <ListBox x:Name="FriendsActivityListBox"
                     Foreground="White"
                     Background="#121212"
                     BorderBrush="Transparent"
                     Margin="10"
                     ToolTip="Actividad de Amigos"
                     AutomationProperties.Name="Lista Actividad de Amigos">
                <!-- Ejemplo de amigo -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image Source=".\Images\Itzel.jpg"
                               Width="40"
                               Height="40"
                               Margin="10"
                               VerticalAlignment="Center"
                               ToolTip="Foto de Itzel Durán"
                               AutomationProperties.Name="Avatar de Itzel Durán"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Itzel Durán"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock Text="Anyone - Justin Bieber"
                                       Foreground="Gray"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>
                <!-- Agrega más ListBoxItem para otros amigos -->
            </ListBox>
        </StackPanel>

        <!-- Barra de reproducción reorganizada -->
        <Grid x:Name="PlaybackBar"
              DockPanel.Dock="Bottom"
              Background="#1A1A1A"
              Height="100"
              VerticalAlignment="Bottom"
              Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>    <!-- Álbum art -->
                <ColumnDefinition Width="2*"/>      <!-- Título/Artista -->
                <ColumnDefinition Width="Auto"/>    <!-- Controles anteriores/pausa/siguiente -->
                <ColumnDefinition Width="3*"/>      <!-- Slider de posición -->
                <ColumnDefinition Width="1*"/>      <!-- Slider de volumen -->
                <ColumnDefinition Width="Auto"/>    <!-- Estado del reproductor -->
            </Grid.ColumnDefinitions>

            <!-- 1) Imagen de álbum o logo -->
            <Image x:Name="AlbumArtImage"
                   Grid.Column="0"
                   Source="Images\spotify-icon-spotify-logo-spotify-symbol-logo-set-free-vector.jpg"
                   Width="60"
                   Height="60"
                   Margin="10"
                   VerticalAlignment="Center"
                   ToolTip="Logo Musify"
                   AutomationProperties.Name="Logo Musify"/>

            <!-- 2) Título y artista -->
            <StackPanel Grid.Column="1"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="10">
                <TextBlock x:Name="SongTitle"
                           Text="Título de la canción"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"/>
                <TextBlock x:Name="SongArtist"
                           Text="Artista de la canción"
                           Foreground="Gray"
                           FontSize="12"/>
            </StackPanel>

            <!-- 3) Botones de control -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10">
                <Button x:Name="PreviousButton"
                        Content="⏮"
                        Width="40" Height="40"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"
                        ToolTip="Canción anterior"
                        AutomationProperties.Name="Botón Canción Anterior"
                        Click="PreviousSong_Click"/>

                <Button x:Name="PauseButton"
                        Content="⏸"
                        Width="40" Height="40"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"
                        ToolTip="Pausar/Reanudar"
                        AutomationProperties.Name="Botón Pausar/Reanudar"
                        Click="PauseSong_Click"/>

                <Button x:Name="NextButton"
                        Content="⏭"
                        Width="40" Height="40"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Transparent"
                        ToolTip="Siguiente Canción"
                        AutomationProperties.Name="Botón Canción Siguiente"
                        Click="NextSong_Click"/>
            </StackPanel>

            <!-- 4) Slider de posición -->
            <Slider x:Name="PositionSlider"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Background="#333333"
                    Foreground="#1DB954"
                    BorderBrush="#1DB954"
                    ToolTip="Posición de reproducción"
                    AutomationProperties.Name="Barra de posición"
                    PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseUp"/>

            <!-- 5) Slider de volumen -->
            <Slider x:Name="VolumeSlider"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Minimum="0" Maximum="1" Value="0.5"
                    SmallChange="0.05" LargeChange="0.1"
                    Width="100"
                    Background="#333333"
                    Foreground="#1DB954"
                    BorderBrush="#1DB954"
                    ToolTip="Volumen (0 a 100%)"
                    AutomationProperties.Name="Barra de volumen"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <!-- 6) Estado del reproductor -->
            <TextBlock x:Name="PlayerStatus"
                       Grid.Column="5"
                       Text="Estado del reproductor"
                       Foreground="Gray"
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="10"/>
        </Grid>
    </Grid>
</Window>
