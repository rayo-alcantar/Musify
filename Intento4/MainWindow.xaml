<!-- MainWindow.xaml -->
<Window x:Class="Intento4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Musify" Height="800" Width="1920" Background="#121212"
        MinWidth="800" MinHeight="450">

    <Grid>
        <!-- Frame principal para navegación -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Barra lateral navegación -->
        <StackPanel HorizontalAlignment="Left" Background="#1DB954" Width="200">
            <TextBlock Text="Musify" Foreground="White" FontSize="16" Margin="10" FontWeight="Bold" />

            <Button x:Name="InicioButton"
                    Content="Inicio"
                    ToolTip="Ir a la página de Inicio"
                    AutomationProperties.Name="Botón Inicio"
                    Margin="10"
                    Background="Transparent" Foreground="White" BorderBrush="Transparent"
                    Click="ShowInicio2_Click"/>

            <Button x:Name="ExplorarButton"
                    Content="Explorar"
                    ToolTip="Ir a la página de Explorar"
                    AutomationProperties.Name="Botón Explorar"
                    Margin="10"
                    Background="Transparent" Foreground="White" BorderBrush="Transparent"
                    Click="ShowExplorar_Click"/>

            <Button x:Name="BibliotecaButton"
                    Content="Tu Biblioteca"
                    ToolTip="Ir a Tu Biblioteca"
                    AutomationProperties.Name="Botón Tu Biblioteca"
                    Margin="10"
                    Background="Transparent" Foreground="White" BorderBrush="Transparent"
                    Click="ShowTuBiblioteca_Click"/>

            <Button x:Name="PlaylistButton"
                    Content="Crear Playlist"
                    ToolTip="Ir a Crear Playlist"
                    AutomationProperties.Name="Botón Crear Playlist"
                    Margin="10"
                    Background="Transparent" Foreground="White" BorderBrush="Transparent"
                    Click="ShowPlaylist_Click"/>
        </StackPanel>

        <!-- Panel de actividad de amigos -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#333333" Width="300">
            <TextBlock Text="Actividad de Amigos" Foreground="White" FontSize="16" Margin="10" FontWeight="Bold" />
            <ListBox x:Name="FriendsActivityListBox"
                     Foreground="White" Background="#121212" BorderBrush="Transparent" Margin="10"
                     ToolTip="Actividad de Amigos"
                     AutomationProperties.Name="Lista Actividad de Amigos">

                <!-- Itzel Durán -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image x:Name="ItzelImage"
                               Source=".\Images\Itzel.jpg"
                               Width="40" Height="40" Margin="10" VerticalAlignment="Center"
                               ToolTip="Foto de Itzel Durán"
                               AutomationProperties.Name="Avatar de Itzel Durán"/>
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Itzel Durán" Foreground="White" FontSize="14" />
                            <TextBlock Text="Anyone - Justin Bieber" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>

                <!-- Diego Duron -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image x:Name="DiegoImage"
                               Source=".\Images\Diego.jpg"
                               Width="40" Height="40" Margin="10" VerticalAlignment="Center"
                               ToolTip="Foto de Diego Duron"
                               AutomationProperties.Name="Avatar de Diego Duron"/>
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Diego Duron" Foreground="White" FontSize="14" />
                            <TextBlock Text="Not Like Us - Kendrick Lamar" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>

                <!-- Aldo Durán -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image x:Name="AldoImage"
                               Source=".\Images\Aldo.jpg"
                               Width="40" Height="40" Margin="10" VerticalAlignment="Center"
                               ToolTip="Foto de Aldo Durán"
                               AutomationProperties.Name="Avatar de Aldo Durán"/>
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Aldo Durán" Foreground="White" FontSize="14" />
                            <TextBlock Text="Vista al Mar - Quevedo" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>

                <!-- Fernanda Ávila -->
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Image x:Name="FernandaImage"
                               Source=".\Images\Fernanda.jpg"
                               Width="40" Height="40" Margin="10" VerticalAlignment="Center"
                               ToolTip="Foto de Fernanda Ávila"
                               AutomationProperties.Name="Avatar de Fernanda Ávila"/>
                        <StackPanel VerticalAlignment="Center" Margin="10">
                            <TextBlock Text="Fernanda Ávila" Foreground="White" FontSize="14" />
                            <TextBlock Text="The Archer - Taylor Swift" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ListBoxItem>

            </ListBox>
        </StackPanel>

        <!-- Barra de reproducción -->
        <DockPanel VerticalAlignment="Bottom" Background="#1A1A1A" Height="136">
            <Image x:Name="AlbumArtImage"
                   Source="Images\spotify-icon-spotify-logo-spotify-symbol-logo-set-free-vector.jpg"
                   Width="60" Height="60" Margin="10" VerticalAlignment="Center"
                   ToolTip="Logo Musify"
                   AutomationProperties.Name="Logo Musify"/>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10">
                <TextBlock Name="SongTitle"
                           Text="Título de la canción"
                           Foreground="White" FontSize="14" FontWeight="Bold"/>
                <TextBlock Name="SongArtist"
                           Text="Artista de la canción"
                           Foreground="Gray" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                <Button x:Name="PreviousButton"
                        Content="⏮" Width="40" Height="40"
                        Background="Transparent" Foreground="White" BorderBrush="Transparent"
                        ToolTip="Anterior"
                        AutomationProperties.Name="Botón Canción Anterior"
                        Click="PreviousSong_Click"/>

                <Button x:Name="PauseButton"
                        Content="⏸" Width="40" Height="40"
                        Background="Transparent" Foreground="White" BorderBrush="Transparent"
                        ToolTip="Pausar/Reanudar"
                        AutomationProperties.Name="Botón Pausar/Reanudar"
                        Click="PauseSong_Click"/>

                <Button x:Name="NextButton"
                        Content="⏭" Width="40" Height="40"
                        Background="Transparent" Foreground="White" BorderBrush="Transparent"
                        ToolTip="Siguiente"
                        AutomationProperties.Name="Botón Canción Siguiente"
                        Click="NextSong_Click"/>
            </StackPanel>

            <!-- Slider para posición de reproducción -->
            <Slider x:Name="PositionSlider"
                    Width="200" VerticalAlignment="Center"
                    Minimum="0" Maximum="100" Value="0"
                    Background="#333333" Foreground="#1DB954" BorderBrush="#1DB954"
                    ToolTip="Barra de posición de reproducción"
                    AutomationProperties.Name="Barra de posición de reproducción"
                    PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseDown"
                    PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseUp"/>

            <TextBlock Name="PlayerStatus"
                       Text="Estado del reproductor"
                       Foreground="Gray" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10"/>
        </DockPanel>
    </Grid>
</Window>
